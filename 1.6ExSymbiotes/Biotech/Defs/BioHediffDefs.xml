<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef ParentName="ExSymbiotes_SymbiosisBase">
        <defName>ExSymbiotes_Symbiosis_Purple</defName>
        <label>symbiosis (Purple)</label>
        <stages>
            <li>
                <statFactors>
                    <MeleeDamageFactor>1.25</MeleeDamageFactor>
                    <MoveSpeed>1.50</MoveSpeed>
                    <WorkSpeedGlobal>4.0</WorkSpeedGlobal>
                </statFactors>
                <damageFactors>
                    <Flame>3</Flame>
                    <Burn>3</Burn>
                </damageFactors>
                <statOffsets>
                    <ToxicResistance>1</ToxicResistance>
                    <ComfyTemperatureMax>100</ComfyTemperatureMax>
                    <ComfyTemperatureMin>-200</ComfyTemperatureMin>
                    <MechControlGroups>1</MechControlGroups>
                    <MechRepairSpeed>2</MechRepairSpeed>
                    <MechBandwidth>10</MechBandwidth>
                </statOffsets>
                <capMods>
                    <li><capacity>Consciousness</capacity><postFactor>1.50</postFactor></li>
                    <li><capacity>Hearing</capacity><postFactor>1.50</postFactor></li>
                    <li><capacity>Talking</capacity><postFactor>1.50</postFactor></li>
                    <li><capacity>Manipulation</capacity><postFactor>1.50</postFactor></li>
                    <li><capacity>Sight</capacity><postFactor>1.50</postFactor></li>
                    <li><capacity>Eating</capacity><postFactor>1.50</postFactor></li>
                    <li><capacity>BloodPumping</capacity><postFactor>1.50</postFactor></li>
                    <li><capacity>BloodFiltration</capacity><postFactor>1.50</postFactor></li>
                    <li><capacity>Breathing</capacity><postFactor>1.50</postFactor></li>
                </capMods>
                <regeneration>50</regeneration>
            </li>
        </stages>
        <comps>
            <li Class="ExSymbiotes.HediffCompProperties_SymbioticShield"/>
            <li Class="ExSymbiotes.HediffCompProperties_Symbiosis">
                <color>(188, 120, 194)</color>
                <hair>(188, 120, 194)</hair>
            </li>
            <li Class="HediffCompProperties_GiveAbility">
                <abilityDefs>
                    <li>ExSymbiotes_SymbioticTendrilsPurple</li>
                    <li>ExSymbiotes_SymbioticShield</li>
                    <li>ExSymbiotes_SymbioticCannon</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">ExSymbiotes_SymbioticLongjump</li>
                </abilityDefs>
            </li>
        </comps>
    </HediffDef>

    <HediffDef ParentName="ExSymbiotes_SymbioticTendrilsHediffDef">
        <defName>ExSymbiotes_SymbioticTendrilsPurple</defName>
        <stages Inherit="False">
            <li>
                <statFactors>
                    <WorkSpeedGlobal>4.0</WorkSpeedGlobal>
                </statFactors>
                <capMods>
                    <li><capacity>Manipulation</capacity><postFactor>2</postFactor></li>
                </capMods>
            </li>
        </stages>
        <comps Inherit="False">
            <li Class="ExSymbiotes.HediffCompProperties_SymbioticTendrils">
                <turretGunDef>ExSymbiotes_TendrilTurretPurple</turretGunDef>
                <cd>2.5</cd>
            </li>
            <li Class="HediffCompProperties_Disappears">
                <showRemainingTime>True</showRemainingTime>
            </li>
            <li Class="HediffCompProperties_DisappearsOnDeath"/>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>ExSymbiotes_SymbioticCannon</defName>
        <label>symbiotic cannon</label>
        <hediffClass>HediffWithComps</hediffClass>
        <description>The symbiote build a plasma cannon from the shoulder.</description>
        <isBad>false</isBad>
        <renderNodeProperties>
            <li Class="PawnRenderNodeProperties_Spastic">
                <texPaths>
                    <li>Things/Pawn/SymbioticCannon</li>
                </texPaths>
                <parentTagDef>Body</parentTagDef>
                <overrideMeshSize>1</overrideMeshSize>
                <drawSize>0.75</drawSize>
                <colorType>Custom</colorType>
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
                <useSkinShader>false</useSkinShader>
                <useRottenColor>false</useRottenColor>
                <rotationRange>-5~5</rotationRange>
                <durationTicksRange>10~35</durationTicksRange>
                <nextSpasmTicksRange>10~50</nextSpasmTicksRange>
                <drawData>
                    <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
                    <dataSouth>
                        <offset>(-0.30, 0, 0.2)</offset>
                        <rotationOffset>-90</rotationOffset>
                        <layer>60</layer>
                    </dataSouth>
                    <dataNorth>
                        <offset>(0.25, 0, 0.2)</offset>
                        <rotationOffset>-90</rotationOffset>
                        <layer>100</layer>
                        <flip>true</flip>
                    </dataNorth>
                    <dataEast>
                        <offset>(-0.15, 0, 0.1)</offset>
                        <rotationOffset>-90</rotationOffset>
                        <layer>90</layer>
                        <flip>true</flip>
                    </dataEast>
                    <dataWest>
                        <offset>(0.1, 0, 0.15)</offset>
                        <rotationOffset>-90</rotationOffset>
                        <layer>0</layer>
                    </dataWest>
                </drawData>
            </li>
        </renderNodeProperties>
        <comps>
            <li Class="ExSymbiotes.HediffCompProperties_SymbioticCannon">
                <turretGunDef>ExSymbiotes_TendrilTurretCannon</turretGunDef>
            </li>
            <li Class="HediffCompProperties_Disappears">
                <showRemainingTime>True</showRemainingTime>
            </li>
            <li Class="HediffCompProperties_DisappearsOnDeath"/>
        </comps>
    </HediffDef>

</Defs>