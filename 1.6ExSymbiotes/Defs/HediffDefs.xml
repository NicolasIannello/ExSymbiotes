    <HediffDef Name="ExSymbiotes_SymbioteControl">
        <defName>ExSymbiotes_SymbioteControl</defName>
        <label>symbiote control (black)</label>
        <hediffClass>HediffWithComps</hediffClass>
        <description>This creature has been taken over by a symbiote. It will create a new symbiote in the span of a day. The symbiote will abandon its host once it recieves enough damage or if it is disrupted with fire or EMP.</description>
        <isBad>true</isBad>
        <initialSeverity>0.001</initialSeverity>
        <maxSeverity>1</maxSeverity>
        <alwaysShowSeverity>true</alwaysShowSeverity>
        <stages>
            <li>
                <minSeverity>0</minSeverity>
                <statFactors>
                    <MeleeDamageFactor>1.5</MeleeDamageFactor>
                    <MoveSpeed>1.30</MoveSpeed>
                    <ArmorRating_Sharp>1.20</ArmorRating_Sharp>
                    <ArmorRating_Blunt>1.20</ArmorRating_Blunt>
                </statFactors>
                <statOffsets>
                    <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
                    <ToxicResistance>1</ToxicResistance>
                    <ComfyTemperatureMax>100</ComfyTemperatureMax>
                    <ComfyTemperatureMin>-200</ComfyTemperatureMin>
                </statOffsets>
                <capMods>
                    <li><capacity>Consciousness</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Hearing</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Talking</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Manipulation</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Sight</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Eating</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>BloodPumping</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>BloodFiltration</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Breathing</capacity><postFactor>1.25</postFactor></li>
                </capMods>
                <regeneration>350</regeneration>
                <disablesNeeds>
                    <li>Rest</li>
                </disablesNeeds>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>0.55</severityPerDay>
            </li>
            <li Class="ExSymbiotes.HediffCompProperties_SymbioteControl">
                <color>(31, 27, 28)</color>
                <messageEmerged>{PAWN_nameDef} emerged from the symbiote.</messageEmerged>
                <messageEmergedCause>The {CAUSE} made the symbiote leave {PAWN_nameDef} body.</messageEmergedCause>
                <messageEmergedCorpse>{PAWN_nameDef} emerged from the symbiote's corpse.</messageEmergedCorpse>
            </li>
        </comps>
