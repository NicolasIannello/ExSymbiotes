    <HediffDef>
        <defName>ExSymbiotes_SymbioticArmor</defName>
        <label>symbiotic armor</label>
        <hediffClass>HediffWithComps</hediffClass>
        <description>The symbiote builds a hardened overlay of tissue over the user.</description>
        <isBad>false</isBad>
        <stages>
            <li>
                <statOffsets>
                    <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
                </statOffsets>
                <statFactors>
                    <ArmorRating_Sharp>1.20</ArmorRating_Sharp>
                    <ArmorRating_Blunt>1.20</ArmorRating_Blunt>
                </statFactors>
                <regeneration>250</regeneration>
            </li>
        </stages>
        <comps>
            <li Class="ExSymbiotes.HediffCompProperties_SymbioticArmor"/>
            <li Class="HediffCompProperties_Disappears">
                <showRemainingTime>True</showRemainingTime>
            </li>
            <li Class="HediffCompProperties_DisappearsOnDeath"/>
        </comps>
    </HediffDef>

