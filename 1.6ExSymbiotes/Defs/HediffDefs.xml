<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>ExSymbiotes_Symbiosis</defName>
        <label>symbiosis</label>
        <hediffClass>HediffWithComps</hediffClass>
        <description>This has perform symbiosis with a symbiotic core.The symbiote lives inside them, guiding their actions and twisting their flesh.</description>
        <isBad>false</isBad>
        <hairColorOverride>(31, 27, 28)</hairColorOverride>
        <skinColorOverride>(31, 27, 28)</skinColorOverride>
        <stages>
            <li>
                <statFactors>
                    <MeleeDamageFactor>1.5</MeleeDamageFactor>
                    <MoveSpeed>1.30</MoveSpeed>
                    <WorkSpeedGlobal>2.0</WorkSpeedGlobal>
                </statFactors>
                <capMods>
                    <li><capacity>Manipulation</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Sight</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Eating</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>BloodPumping</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>BloodFiltration</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Breathing</capacity><postFactor>1.25</postFactor></li>
                </capMods>
                <regeneration>50</regeneration>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_GiveAbility">
                <abilityDefs>
                    <li>ExSymbiotes_SymbioticArmor</li>
                </abilityDefs>
            </li>
        </comps>
        <renderNodeProperties>
            <li Class="PawnRenderNodeProperties_Eye">
                <texPath>Things/Pawn/Symbiote/Attachments/Eye/SymbioticEye</texPath>
                <parentTagDef>Head</parentTagDef>
                <anchorTag>RightEye</anchorTag>
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
                <drawSize>0.35</drawSize>
                <side>Right</side>
                <drawData>
                    <defaultData>
                        <layer>54</layer>
                        <offset>(-0.015, 0, -0.24)</offset>
                    </defaultData>
                </drawData>
            </li>
            <li Class="PawnRenderNodeProperties_Eye">
                <texPath>Things/Pawn/Symbiote/Attachments/Eye/SymbioticEye</texPath>
                <parentTagDef>Head</parentTagDef>
                <anchorTag>LeftEye</anchorTag>
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
                <drawSize>0.35</drawSize>
                <side>Left</side>
                <drawData>
                    <defaultData>
                        <layer>54</layer>
                        <offset>(+0.015, 0, -0.24)</offset>
                        <flip>true</flip>
                    </defaultData>
                    <dataWest>
                        <flip>false</flip>
                    </dataWest>
                </drawData>
            </li>
            <!--            <li Class="PawnRenderNodeProperties_Eye">-->
            <!--                <texPath>Things/Pawn/Symbiote/Attachments/Symbiosis/Symbiosis</texPath>-->
            <!--                <texPathFemale>Things/Pawn/Symbiote/Attachments/Symbiosis/Symbiosis</texPathFemale>-->
            <!--                <parentTagDef>Body</parentTagDef>-->
            <!--                <anchorTag>Torso</anchorTag>-->
            <!--                <rotDrawMode>Fresh, Rotting</rotDrawMode>-->
            <!--                <drawSize>1</drawSize>-->
            <!--                <drawData>-->
            <!--                    <defaultData>-->
            <!--                        <layer>5</layer>-->
            <!--                        <offset>(0, 0, 0)</offset>-->
            <!--                    </defaultData>-->
            <!--                </drawData>-->
            <!--            </li>-->
            <li Class="PawnRenderNodeProperties_Spastic">
                <texPath>Things/Pawn/Symbiote/Attachments/Symbiosis/Symbiosis</texPath>
                <parentTagDef>Body</parentTagDef>
                <anchorTag>Torso</anchorTag>
                <overrideMeshSize>(1.0)</overrideMeshSize>
                <drawSize>1</drawSize>
                <!--                <colorType>Skin</colorType>-->
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
                <!--                <useSkinShader>true</useSkinShader>-->
                <useRottenColor>true</useRottenColor>
                <!--                <rotationRange>-30~30</rotationRange>-->
                <!--                <durationTicksRange>10~35</durationTicksRange>-->
                <!--                <nextSpasmTicksRange>10~50</nextSpasmTicksRange>-->
                <drawData>
                    <scaleOffsetByBodySize>false</scaleOffsetByBodySize>
                    <!--                    <useBodyPartAnchor>true</useBodyPartAnchor>-->
                    <childScale>0.7</childScale>
                    <bodyTypeScales>
                        <Male>1.5</Male>
                        <Female>1.2</Female>
                        <Hulk>2</Hulk>
                        <Fat>1.6</Fat>
                        <Thin>0.7</Thin>
                    </bodyTypeScales>
                    <defaultData>
                        <layer>5</layer>
                    </defaultData>
                    <dataNorth>
                        <rotationOffset>0</rotationOffset>
                        <flip>true</flip>
                    </dataNorth>
                    <dataEast>
                        <rotationOffset>280</rotationOffset>
                    </dataEast>
                    <dataSouth>
                        <rotationOffset>180</rotationOffset>
                    </dataSouth>
                    <dataWest>
                        <rotationOffset>270</rotationOffset>
                        <flip>true</flip>
                    </dataWest>
                </drawData>
            </li>
        </renderNodeProperties>
    </HediffDef>

    <HediffDef>
        <defName>ExSymbiotes_SymbioticArmor</defName>
        <label>symbiotic armor</label>
        <hediffClass>HediffWithComps</hediffClass>
        <description>The symbiote builds a hardened overlay of tissue over the user.</description>
        <isBad>false</isBad>
        <stages>
            <li>
                <statOffsets>
                    <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
                </statOffsets>
                <statFactors>
                    <ArmorRating_Sharp>1.20</ArmorRating_Sharp>
                    <ArmorRating_Blunt>1.20</ArmorRating_Blunt>
                </statFactors>
                <regeneration>250</regeneration>
            </li>
        </stages>
        <comps>
            <li Class="ExSymbiotes.HediffCompProperties_SymbioticArmor"/>
            <li Class="HediffCompProperties_Disappears">
                <showRemainingTime>True</showRemainingTime>
            </li>
            <li Class="HediffCompProperties_DisappearsOnDeath"/>
        </comps>
    </HediffDef>
</Defs>