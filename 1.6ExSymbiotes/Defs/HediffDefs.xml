<Defs>
    <HediffDef Name="ExSymbiotes_Symbiosis">
        <defName>ExSymbiotes_Symbiosis</defName>
        <label>symbiosis (Black)</label>
        <hediffClass>ExSymbiotes.HediffWithComps_Symbiosis</hediffClass>
        <description>This person has perform symbiosis with a symbiotic core.The symbiote lives inside them, guiding their actions and twisting their flesh.</description>
        <isBad>false</isBad>
        <hairColorOverride>(31, 27, 28)</hairColorOverride>
        <stages>
            <li>
                <statFactors>
                    <MeleeDamageFactor>1.5</MeleeDamageFactor>
                    <MoveSpeed>1.30</MoveSpeed>
                    <WorkSpeedGlobal>2.0</WorkSpeedGlobal>
                    <IncomingDamageFactor>0.5</IncomingDamageFactor>
                </statFactors>
                <damageFactors>
                    <Flame>5</Flame>
                    <Burn>5</Burn>
                </damageFactors>
                <statOffsets>
                    <ToxicResistance>1</ToxicResistance>
                    <ComfyTemperatureMax>100</ComfyTemperatureMax>
                    <ComfyTemperatureMin>-200</ComfyTemperatureMin>
                </statOffsets>
                <capMods>
                    <li><capacity>Consciousness</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Hearing</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Talking</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Manipulation</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Sight</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Eating</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>BloodPumping</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>BloodFiltration</capacity><postFactor>1.25</postFactor></li>
                    <li><capacity>Breathing</capacity><postFactor>1.25</postFactor></li>
                </capMods>
                <regeneration>50</regeneration>
            </li>
        </stages>
        <comps>
            <li Class="ExSymbiotes.HediffCompProperties_Symbiosis">
                <color>(31, 27, 28)</color>        
            </li>
            <li Class="HediffCompProperties_GiveAbility">
                <abilityDefs>
                    <li>ExSymbiotes_SymbioticArmor</li>
                    <li>ExSymbiotes_SymbioticTendrilsWeak</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">ExSymbiotes_SymbioticCoagulate</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">ExSymbiotes_SymbioticLongjump</li>
                </abilityDefs>
            </li>
        </comps>
        <renderNodeProperties>
            <li Class="PawnRenderNodeProperties_Eye">
                <texPath>Things/Pawn/Symbiote/Attachments/Eye/SymbioticEye</texPath>
                <parentTagDef>Head</parentTagDef>
                <anchorTag>RightEye</anchorTag>
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
                <drawSize>0.35</drawSize>
                <side>Right</side>
                <drawData>
                    <defaultData>
                        <layer>55</layer>
                        <offset>(-0.015, 0, -0.24)</offset>
                    </defaultData>
                </drawData>
            </li>
            <li Class="PawnRenderNodeProperties_Eye">
                <texPath>Things/Pawn/Symbiote/Attachments/Eye/SymbioticEye</texPath>
                <parentTagDef>Head</parentTagDef>
                <anchorTag>LeftEye</anchorTag>
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
