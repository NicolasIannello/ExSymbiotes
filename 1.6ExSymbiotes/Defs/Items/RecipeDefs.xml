<Defs>
    <RecipeDef Name="ExSymbiotes_Make_Leather_Symbiotic">
        <defName>ExSymbiotes_Make_Leather_Symbiotic</defName>
        <label>make symbiotic leather (black)</label>
        <description>Imbue leathers with symbiotic tissue.</description>
        <jobString>Making symbiotic leather (black).</jobString>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <effectWorking>Tailor</effectWorking>
        <soundWorking>Recipe_Tailor</soundWorking>
        <workAmount>900</workAmount>
        <allowMixingIngredients>true</allowMixingIngredients>
        <targetCountAdjustment>50</targetCountAdjustment>
        <researchPrerequisite>ExSymbiotes_SymbioticTissueResearch</researchPrerequisite>
        <recipeUsers>
            <li>BioferriteShaper</li>
        </recipeUsers>
        <ingredients>
            <li>
                <filter>
                    <categories>
                        <li>Leathers</li>
                    </categories>
                </filter>
                <count>10</count>
            </li>
            <li>
                <filter>
                    <thingDefs><li>ExSymbiotes_SymbioticTissue</li></thingDefs>
                </filter>
                <count>10</count>
            </li>
            <li>
                <filter>
                    <thingDefs><li>Bioferrite</li></thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <categories>
                <li>Leathers</li>
            </categories>
            <thingDefs><li>Bioferrite</li></thingDefs>
            <thingDefs><li>ExSymbiotes_SymbioticTissue</li></thingDefs>
            <disallowedThingDefs>
                <li>ExSymbiotes_Leather_Symbiotic</li>
            </disallowedThingDefs>
        </fixedIngredientFilter>
        <products>
            <ExSymbiotes_Leather_Symbiotic>10</ExSymbiotes_Leather_Symbiotic>
        </products>
        <workSkill>Crafting</workSkill>
        <displayPriority>100</displayPriority>
    </RecipeDef>

