<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <AbilityDef>
        <defName>ExSymbiotes_SymbioticArmor</defName>
        <label>symbiotic armor</label>
        <description>The symbiote builds a hardened overlay of tissue over the user.</description>
        <iconPath>UI/SymbioticArmor</iconPath>
        <cooldownTicksRange>300</cooldownTicksRange>
        <writeCombatLog>True</writeCombatLog>
        <targetRequired>false</targetRequired>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <statBases>
            <Ability_Duration>30</Ability_Duration>
        </statBases>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <drawAimPie>false</drawAimPie>
            <requireLineOfSight>false</requireLineOfSight>
            <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
            <warmupTime>1</warmupTime>
            <range>19.9</range>
            <targetable>false</targetable>
            <targetParams>
                <canTargetSelf>True</canTargetSelf>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="ExSymbiotes.CompProperties_AbilitySymbiosisCost">
                <symbiosisCost>4</symbiosisCost>
            </li>
            <li Class="CompProperties_AbilityGiveHediff">
                <compClass>CompAbilityEffect_GiveHediff</compClass>
                <hediffDef>ExSymbiotes_SymbioticArmor</hediffDef>
            </li>
            <li Class="CompProperties_AbilityFleckOnTarget">
                <fleckDef>UnnaturalHealing</fleckDef>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>ExSymbiotes_SymbioticScythe</defName>
        <label>symbiotic scythe</label>
        <description>The symbiote mutates the user arm into a scythe, dropping the current weapon on the ground.</description>
        <iconPath>UI/SymbioticScythe</iconPath>
        <cooldownTicksRange>300</cooldownTicksRange>
        <writeCombatLog>True</writeCombatLog>
        <targetRequired>false</targetRequired>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <statBases>
            <Ability_Duration>120</Ability_Duration>
        </statBases>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <drawAimPie>false</drawAimPie>
            <requireLineOfSight>false</requireLineOfSight>
            <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
            <warmupTime>1</warmupTime>
            <range>19.9</range>
            <targetable>false</targetable>
            <targetParams>
                <canTargetSelf>True</canTargetSelf>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="ExSymbiotes.CompProperties_AbilitySymbiosisCost">
                <symbiosisCost>4</symbiosisCost>
            </li>
            <li Class="CompProperties_AbilityGiveHediff">
                <compClass>CompAbilityEffect_GiveHediff</compClass>
                <hediffDef>ExSymbiotes_SymbioticScythe</hediffDef>
                <replaceExisting>true</replaceExisting>
            </li>
            <li Class="CompProperties_AbilityFleckOnTarget">
                <fleckDef>BloodSplash</fleckDef>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>ExSymbiotes_SymbioticTendrils</defName>
        <label>symbiotic tendrils</label>
        <description>Four symbiotic tendrils protude from the back of the user shooting enemies that get too close.</description>
        <iconPath>UI/SymbioticTendrils</iconPath>
        <cooldownTicksRange>300</cooldownTicksRange>
        <writeCombatLog>True</writeCombatLog>
        <targetRequired>false</targetRequired>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <statBases>
            <Ability_Duration>60</Ability_Duration>
        </statBases>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <drawAimPie>false</drawAimPie>
            <requireLineOfSight>false</requireLineOfSight>
            <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
            <warmupTime>1</warmupTime>
            <range>19.9</range>
            <targetable>false</targetable>
            <targetParams>
                <canTargetSelf>True</canTargetSelf>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="ExSymbiotes.CompProperties_AbilitySymbiosisCost">
                <symbiosisCost>4</symbiosisCost>
            </li>
            <li Class="CompProperties_AbilityGiveHediff">
                <compClass>CompAbilityEffect_GiveHediff</compClass>
                <hediffDef>ExSymbiotes_SymbioticTendrils</hediffDef>
            </li>
            <li Class="CompProperties_AbilityFleckOnTarget">
                <fleckDef>BloodSplash</fleckDef>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>ExSymbiotes_SymbiosisLeap</defName>
        <label>consume leap</label>
        <description>Leap onto a target and begin symbiosis.</description>
        <cooldownTicksRange>6000</cooldownTicksRange> <!-- 1.44 hours -->
        <jobDef>CastJump</jobDef>
        <ai_IsOffensive>true</ai_IsOffensive>
        <aiCanUse>true</aiCanUse>
        <verbProperties>
            <verbClass>Verb_CastAbilityConsumeLeap</verbClass>
            <label>consume leap</label>
            <range>7</range>
            <requireLineOfSight>true</requireLineOfSight>
            <warmupTime>0.10</warmupTime>
            <soundCast>Pawn_Devourer_Jump</soundCast>
            <soundLanding>Pawn_Devourer_Land</soundLanding>
            <targetParams>
                <canTargetBuildings>false</canTargetBuildings>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="ExSymbiotes.CompProperties_SymbiosisLeap"/>
        </comps>
    </AbilityDef>
</Defs>