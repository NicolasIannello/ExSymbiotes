<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<IncidentDef Name="ExSymbiotes_SymbioteMassBase" ParentName="AnomalyIncidentBase" Abstract="True">
		<category>ThreatBig</category>
		<targetTags>
			<li>Map_PlayerHome</li>
		</targetTags>
		<letterText>A mysterious symbiote mass has crashed nearby.\n\nThe symbiote mass pulsates with putrid psychic energy, gradually intensifying as it approaches some dangerous limit. You can send colonists to suppress the symbiote mass to prevent it from waking up.\n\nYou can also mark the symbiote mass for study to try to learn its purpose and perhaps make use of it.\n\nYou can always attack the symbiote mass to destroy it, but doing so may unleash unnatural and dangerous phenomena.</letterText>
		<letterDef>NeutralEvent</letterDef>
		<baseChance>0.5</baseChance>
		<earliestDay>30</earliestDay>
		<minRefireDays>50</minRefireDays>
		<minAnomalyThreatLevel>2</minAnomalyThreatLevel>
	</IncidentDef>
	
	<IncidentDef ParentName="ExSymbiotes_SymbioteMassBase">
		<defName>ExSymbiotes_SymbioteMass_Incident</defName>
		<label>symbiote mass</label>
		<letterLabel>Symbiote mass</letterLabel>
		<workerClass>ExSymbiotes.IncidentWorker_SymbioteMass</workerClass>
	</IncidentDef>

	<IncidentDef Name="ExSymbiotes_SymbiotePack" ParentName="AnomalyIncidentBase">
		<defName>ExSymbiotes_SymbiotePack</defName>
		<label>symbiote pack</label>
		<targetTags>
			<li>Map_PlayerHome</li>
			<li>Map_TempIncident</li>
			<li>Map_Misc</li>
			<li>Map_RaidBeacon</li>
			<li>Caravan</li>
		</targetTags>
		<workerClass>ExSymbiotes.IncidentWorker_SymbiotePack</workerClass>
		<baseChance>2.0</baseChance>
		<category>ThreatBig</category>
		<pointsScaleable>true</pointsScaleable>
		<tale>ExSymbiotes_SymbiotePack</tale>
		<letterHyperlinkHediffDefs>
			<li>ExSymbiotes_SymbioteControl</li>
			<li>ExSymbiotes_SymbioteControlRed</li>
			<li>ExSymbiotes_SymbioticTendrils</li>
		</letterHyperlinkHediffDefs>
		<minAnomalyThreatLevel>2</minAnomalyThreatLevel>
		<requireColonistsPresent>True</requireColonistsPresent>
		<minThreatPoints>800</minThreatPoints>
	</IncidentDef>

	<IncidentDef ParentName="ExSymbiotes_SymbiotePack">
