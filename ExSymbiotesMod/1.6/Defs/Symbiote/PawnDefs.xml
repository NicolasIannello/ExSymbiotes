			<renderTree>ExSymbiotes_GrendelSymbiote_PawnRenderTree</renderTree>
			<baseBodySize>6.00</baseBodySize>
			<baseHealthScale>50</baseHealthScale>
			<lifeStageAges>
				<li>
					<def>EntityFullyFormed</def>
					<soundWounded>Pawn_Fleshbeast_Trispike_Wounded</soundWounded>
					<soundDeath>Pawn_Fleshbeast_Trispike_Death</soundDeath>
					<soundCall>Pawn_Fleshbeast_Trispike_Call</soundCall>
				</li>
			</lifeStageAges>
		</race>
		<uiIconPath>Things/Pawn/Grendel/GrendelSymbiote</uiIconPath>
		<comps Inherit="False">
			<li Class="ExSymbiotes.CompProperties_GrendelSymbiote"/>
			<li Class="CompProperties_Studiable">
				<frequencyTicks>120000</frequencyTicks>
				<knowledgeCategory>Advanced</knowledgeCategory>
				<minMonolithLevelForStudy>3</minMonolithLevelForStudy>
				<anomalyKnowledge>5</anomalyKnowledge>
				<requiresHoldingPlatform>true</requiresHoldingPlatform>
			</li>
			<li Class="CompProperties_ProducesBioferrite">
				<bioferriteDensity>10</bioferriteDensity>
			</li>
		</comps>
		<tools Inherit="False">
			<li>
				<label>teeth</label>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>60</power>
				<armorPenetration>0.8</armorPenetration>
				<cooldownTime>0.7</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
			</li>
			<li>
				<label>claws</label>
				<capacities>
					<li>Scratch</li>
				</capacities>
				<power>50</power>
				<armorPenetration>0.6</armorPenetration>
				<cooldownTime>1</cooldownTime>
				<linkedBodyPartsGroup>FrontRightClaws</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
			</li>
			<li>
				<label>tail</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>40</power>
				<armorPenetration>0.2</armorPenetration>
				<cooldownTime>1.4</cooldownTime>
			</li>
		</tools>
	</ThingDef>
	
