<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BasePawn" Name="ExSymbiotes_BaseSymbiote" Abstract="True">
		<statBases>
			<ComfyTemperatureMin>-200</ComfyTemperatureMin>
			<ComfyTemperatureMax>100</ComfyTemperatureMax>
			<Flammability>2</Flammability>
			<MeatAmount>0</MeatAmount>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
			<EMPResistance>0.6</EMPResistance>
		</statBases>
		<tradeability>None</tradeability>
		<hiddenWhileUndiscovered>true</hiddenWhileUndiscovered>
		<race>
			<thinkTreeMain>ExSymbiotes_Symbiote</thinkTreeMain>
			<thinkTreeConstant>ExSymbiotes_SymbioteConstant</thinkTreeConstant>
			<renderTree>ExSymbiotes_Symbiote_PawnRenderTree</renderTree>
			<intelligence>ToolUser</intelligence>
			<specificMeatDef>Meat_Twisted</specificMeatDef>
			<disableIgniteVerb>true</disableIgniteVerb>
			<canOpenFactionlessDoors>false</canOpenFactionlessDoors>
			<needsRest>false</needsRest>
			<hasGenders>false</hasGenders>
			<foodType>None</foodType>
			<bloodDef>Filth_DarkBlood</bloodDef>
			<bloodSmearDef>ExSymbiotes_Filth_BloodSmear_Black</bloodSmearDef>
			<soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
			<soundMeleeDodge>Pawn_MeleeDodge</soundMeleeDodge>
			<trainability>None</trainability>
			<fleshType>EntityMechanical</fleshType>
			<isImmuneToInfections>true</isImmuneToInfections>
			<bleedRateFactor>0</bleedRateFactor>
			<hediffGiverSets>
				<li>AnomalyEntity</li>
			</hediffGiverSets>
			<corpseHiddenWhileUndiscovered>true</corpseHiddenWhileUndiscovered>
			<lifeExpectancy>300</lifeExpectancy>
		</race>
		<comps>
			<li Class="ExSymbiotes.CompProperties_Symbiote">
				<messageDigested>A symbiote swallowed {PAWN_nameDef} whole! Kill the symbiote before it takes control over {PAWN_nameDef}.</messageDigested>
				<messageEmerged>{PAWN_nameDef} emerged from the symbiote.</messageEmerged>
				<messageEmergedCause>The {CAUSE} made the symbiote leave {PAWN_nameDef} body.</messageEmergedCause>
				<messageEmergedCorpse>{PAWN_nameDef} emerged from the symbiote's corpse.</messageEmergedCorpse>
				<messageDigestionCompleted>The symbiote has taken control over {PAWN_nameDef}.</messageDigestionCompleted>
				<digestingInspector>Controling {PAWN_nameDef}: {SECONDS} seconds left</digestingInspector>
				<messageRetaliate>The symbiote inside {PAWN_nameDef} retaliates towards the controlling attemp.</messageRetaliate>
				<digestTime>20</digestTime>
				<digestTimeNonHumanlike>5</digestTimeNonHumanlike>
			</li>
			<li Class="CompProperties_AttachPoints">
				<points>
					<li>
						<offset>(-.35, 0, .35)</offset>
						<type>PlatformRestraint0</type>
					</li>
					<li>
						<offset>(.35, 0, .35)</offset>
						<type>PlatformRestraint1</type>
					</li>
					<li>
						<offset>(.35, 0, -.35)</offset>
						<type>PlatformRestraint2</type>
					</li>
					<li>
						<offset>(-.35, 0, -.35)</offset>
						<type>PlatformRestraint3</type>
					</li>
				</points>
			</li>
			<li Class="CompProperties_HoldingPlatformTarget">
				<baseEscapeIntervalMtbDays>30</baseEscapeIntervalMtbDays>
				<getsColdContainmentBonus>false</getsColdContainmentBonus>
			</li>
			<li Class="CompProperties_InspectString">
				<compClass>CompInspectStringEmergence</compClass>
				<inspectString>Emerged from {SOURCEPAWN_labelShort}.</inspectString>
			</li>
		</comps>
	</ThingDef>

	<ThingDef Name="ExSymbiotes_Symbiote" ParentName="ExSymbiotes_BaseSymbiote">
		<defName>ExSymbiotes_Symbiote</defName>
		<label>symbiote (black)</label>
		<description>Inorganic, amorphous, symbiotic extraterrestrials that bond with other organisms. Higly weak to fire or EMP</description>
		<statBases>
			<MoveSpeed>5</MoveSpeed>
			<MinimumContainmentStrength>40</MinimumContainmentStrength>
			<ToxicResistance>1</ToxicResistance>
		</statBases>
		<uiIconPath>Things/Pawn/Symbiote/Black/Symbiote</uiIconPath>
		<race>
			<body>ExSymbiotes_Body</body>
			<baseBodySize>1</baseBodySize>
			<baseHealthScale>2</baseHealthScale>
			<deathAction Class="DeathActionProperties_Vanish">
				<workerClass>ExSymbiotes.DeathActionWorker_VanishSymbiote</workerClass>
				<filth>Filth_RevenantBloodPool</filth>
				<filthCountRange>1~2</filthCountRange>
				<meatExplosionSize>Normal</meatExplosionSize>
			</deathAction>
			<lifeStageAges>
				<li>
					<def>EntityFullyFormed</def>
					<soundWounded>Pawn_Fleshbeast_Trispike_Wounded</soundWounded>
					<soundDeath>Pawn_Fleshbeast_Trispike_Death</soundDeath>
					<soundCall>Pawn_Fleshbeast_Trispike_Call</soundCall>
				</li>
			</lifeStageAges>
		</race>
		<comps>
			<li Class="CompProperties_Studiable">
				<frequencyTicks>120000</frequencyTicks>
				<knowledgeCategory>Advanced</knowledgeCategory>
				<minMonolithLevelForStudy>1</minMonolithLevelForStudy>
				<anomalyKnowledge>2</anomalyKnowledge>
				<requiresHoldingPlatform>true</requiresHoldingPlatform>
			</li>
			<li Class="CompProperties_ProducesBioferrite">
				<bioferriteDensity>2</bioferriteDensity>
			</li>
		</comps>
		<tools>
			<li>
				<label>teeth</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>15</power>
				<armorPenetration>0.2</armorPenetration>
				<cooldownTime>2.5</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
			</li>
		</tools>
	</ThingDef>

	<ThingDef ParentName="ExSymbiotes_Symbiote">
