	<ThingDef ParentName="ExSymbiotes_BaseSymbiote">
		<defName>ExSymbiotes_SymbioteGrendel</defName>
		<label>grendel symbiote</label>
		<description>Inorganic, amorphous, symbiotic extraterrestrials with the form of a dragon.</description>
		<statBases>
			<MoveSpeed>8</MoveSpeed>
			<MinimumContainmentStrength>100</MinimumContainmentStrength>
			<ToxicResistance>1</ToxicResistance>
			<PsychicSensitivity>0</PsychicSensitivity>
			<StaggerDurationFactor>0</StaggerDurationFactor>
			<IncomingDamageFactor>0.2</IncomingDamageFactor>
			<EMPResistance>0.9</EMPResistance>
		</statBases>
		<race>
			<body>QuadrupedAnimalWithClawsTailAndJowl</body>
